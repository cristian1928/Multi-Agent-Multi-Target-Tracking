
# read A1_state_data from csv
import pandas as pd
from pathlib import Path
from datetime import datetime
import matplotlib.pyplot as plt
data_dir = Path('runs/flow_simulation_data/ic_simulation_data')
data_dir.mkdir(parents=True, exist_ok=True)
out_dir = Path('runs/flow_simulation_data/ic_xy_data')
out_dir.mkdir(parents=True, exist_ok=True)

# Change this to the number of files you want created (1..n)
n = 6

# create numbered files (A1_state_data_1.csv ... A1_state_data_n.csv) if missing
for i in range(1, n + 1):
    print(i)
    p = data_dir / f'ic_{i}/simulation_data/agent_data/A1_state_data.csv'
    # ex: p = Path('runs/k_1/simulation_data/agent_data/A1_state_data_1.csv')
    if not p.exists():
        p.write_text('Position X,Position Y\n')
        # this is where the code that actually writes data into the files goes.
    # collect matching files and read them
    # create two lists to hold x and y data

    # print [1] and [2] from 'X_position' and 'Y_position' columns from csv file
    x_data = []
    y_data = []
    print(p)
    # append [1] and [2] to x_data and y_data from csv file

    print('x:', x_data)
    # create new file in path runs/flow_simulation_data
    # for csv_file in p:
    df = pd.read_csv(p)
    # collect Position X/Y from the dataframe (if present)
    if 'Position X' in df.columns and 'Position Y' in df.columns:
        x_data.extend(df['Position X'].tolist())
        y_data.extend(df['Position Y'].tolist())
    else:
        # nothing to append for this file
        print(f"Warning: {p} missing Position X/Y columns")

    out_path = out_dir / f'A1_state_data_{i}.csv'
    # write header and rows (two columns)
    with out_path.open('w') as f:
        f.write('Position X,Position Y\n')
        for x, y in zip(x_data, y_data):
            f.write(f"{x},{y}\n")

